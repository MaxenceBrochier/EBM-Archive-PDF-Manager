{
  "max_pages": 3,
  "max_matches": 10,
  "exclude_dirs": ["$RECYCLE.BIN", "System Volume Information"],
  "fields": [
    {
      "name": "lot",
      "label": "N° de lot",
      "regex": "(?:(?i:N°|No\\.?|Num[ée]ro)\\s*(?i:de\\s+)?(?i:lot)\\s*[:.]?|(?m:^)[ \\t]*(?i:Lot)[ \\t]*:)\\s*([A-Z0-9/-]*[0-9][A-Z0-9/-]*)",
      "uppercase": true
    },
    {
      "name": "of",
      "label": "Ordre de fabrication",
      "regex": "(?i:Ordre de fabrication)\\s*:\\s*([A-Z0-9]*[0-9][A-Z0-9]*(\\s*/\\s*[0-9]+)?)",
      "uppercase": true,
      "sections": ["VAL"]
    },
    {
      "name": "code_produit",
      "label": "Code produit",
      "regex": "(?i:Code Produit)\\s*:\\s*([A-Z0-9_-]+)",
      "uppercase": true,
      "sections": ["VAL"]
    },
    {
      "name": "debut_fabrication",
      "label": "Début de fabrication",
      "regex": "(?i:Début de Fabrication)\\s*:\\s*([0-9]{2}[./-][0-9]{2}[./-][0-9]{4})",
      "sections": ["VAL"]
    },
    {
      "name": "fin_fabrication",
      "label": "Fin de fabrication",
      "regex": "(?i:Fin de Fabrication)\\s*:\\s*([0-9]{2}[./-][0-9]{2}[./-][0-9]{4})",
      "sections": ["VAL"]
    },
    {
      "name": "taille_lot",
      "label": "Taille du lot",
      "regex": "(?i:Taille du Lot)\\s*:\\s*((([0-9]{1,4})|[0-9]{1,3}['’][0-9]{3})\\s*(?i:kg|ku|un|ml|l)\\b)",
      "sections": ["VAL"]
    }
  ]
}
