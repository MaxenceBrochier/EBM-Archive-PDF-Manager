{
  "max_pages": 2,
  "max_matches": 1,
  "primary_only": true,
  "exclude_dirs": ["$RECYCLE.BIN", "System Volume Information"],
  "fields": [
    {
      "name": "lot",
      "label": "N° de lot",
      "regex": "(?mi)^[ \\t]*(?:Lot(?:[ \\t]+(?:Number|No\\.?))?|Batch(?:[ \\t]+Number)?|(?:N[°º]|No\\.?|Num[ée]ro)[ \\t]*(?:(?:de|du)[ \\t]+)?lot)[ \\t]*(?::[ \\t]*|[ \\t]+)([A-Z0-9/-]*[0-9][A-Z0-9/-]*)(?:[ \\t\\r]|$)",
      "uppercase": true
    },
    {
      "name": "of",
      "label": "Ordre de fabrication",
      "regex": "(?mi)(?:^[ \\t]*(?:Ordre[ \\t]+de[ \\t]+fabrication|Num[ée]ro[ \\t]+de[ \\t]+WO|Work[ \\t]+Order|WO|OF)[ \\t]*(?::[ \\t]*|[ \\t]+)|[ \\t]+(?:OF|WO)[ \\t]*:[ \\t]*)([A-Z0-9]*[0-9][A-Z0-9]*(?:[ \\t]*/[ \\t]*[0-9]+)?)(?:[ \\t\\r]|$)",
      "uppercase": true,
      "sections": ["VAL", "Batch Report", "Batch Report intermédiaire"]
    },
    {
      "name": "code_produit",
      "label": "Code produit",
      "regex": "(?mi)(?:^|[ \\t]+)(?:Code[ \\t]+Produit|Product[ \\t]+code|Code[ \\t]+article)[ \\t]*(?::[ \\t]*|[ \\t]+)([A-Z0-9_-]+)(?:[ \\t\\r]|$)",
      "uppercase": true,
      "sections": ["VAL", "Batch Report", "Batch Report intermédiaire"]
    },
    {
      "name": "debut_fabrication",
      "label": "Début de fabrication",
      "regex": "(?i:Début[ \\t]+de[ \\t]+Fabrication)[ \\t]*:[ \\t]*([0-9]{2}[./-][0-9]{2}[./-][0-9]{4})",
      "sections": ["VAL"]
    },
    {
      "name": "fin_fabrication",
      "label": "Fin de fabrication",
      "regex": "(?i:Fin[ \\t]+de[ \\t]+Fabrication)[ \\t]*:[ \\t]*([0-9]{2}[./-][0-9]{2}[./-][0-9]{4})",
      "sections": ["VAL"]
    },
    {
      "name": "taille_lot",
      "label": "Taille du lot",
      "regex": "(?mi)(?:^|[ \\t]+)(?:Taille[ \\t]+du[ \\t]+Lot|Quantit[ée][ \\t]+du[ \\t]+WO|Quantit[ée][ \\t]+transf[ée]r[ée]e)[ \\t]*(?::[ \\t]*|[ \\t]+)([0-9]+(?:['’][0-9]{3})*(?:[.,][0-9]+)?[ \\t]*(?:kg|ku|un|ml|l)\\b)",
      "sections": ["VAL", "Batch Report", "Batch Report intermédiaire"]
    }
  ]
}
